# Copy to .env and adjust. Never commit .env.
ENV=development

# Postgres container (docker-compose.yml reads these)
POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wardrobe
# Host port for the db container. Change if 5432 is already taken locally.
DB_HOST_PORT=5432

# App (used when running on the host: make migrate / make test / make dev)
DATABASE_URL=postgresql+psycopg://wardrobe:change-me@localhost:5432/wardrobe
TEST_DATABASE_URL=postgresql+psycopg://wardrobe:change-me@localhost:5432/wardrobe_test

# Closet (Phase 1)
DEV_USER_EMAIL=dev@example.com
MEDIA_ROOT=media
MAX_UPLOAD_MB=10

# Tagging (Phase 2)
# "fake" = offline placeholder tags. "claude" and "gemini" send each (EXIF-stripped) photo to
# the Anthropic / Google Gemini API.
# (uses GEMINI_API_KEY and GEMINI_MODEL, set under Style references below)
TAGGER_BACKEND=fake
TAGGER_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
TAG_CONFIDENCE_THRESHOLD=0.7
MAX_CONCURRENT_PIPELINES=2
MAX_BATCH_FILES=10
REMBG_MODEL=u2net

# Style references (reference photos that re-rank suggestions; optional per request)
# "fake" = offline placeholder, "claude" = Anthropic API, "ollama" = local vision model,
# "gemini" = Google Gemini API (needs GEMINI_API_KEY), "openai" = any OpenAI-compatible host
STYLE_BACKEND=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# openai backend only (uses STYLE_MODEL):
# STYLE_BASE_URL=https://api.openai.com/v1
# STYLE_API_KEY=
STYLE_MODEL=claude-opus-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_SECONDS=180

# Link analysis (Phase 4)
ANALYSES_PER_HOUR=10
CANDIDATE_CACHE_HOURS=24
MAX_CONCURRENT_ANALYSES=2
FETCH_CONNECT_TIMEOUT=5
FETCH_TOTAL_TIMEOUT=15
FETCH_MAX_REDIRECTS=5
FETCH_MAX_HTML_KB=2048
FETCH_HOST_DELAY_SECONDS=1.0
# Dev/test only. Allows loopback/private addresses so a local fixture server can be fetched.
FETCH_ALLOW_PRIVATE_HOSTS=false
# Optional JS rendering through Playwright (install with: uv sync --extra browser)
SCRAPER_USE_BROWSER=false
CANDIDATE_RETENTION_DAYS=30

# Accounts (Phase 5)
# Signs CSRF tokens. Must be private in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me
# true/false. Unset: secure cookies (and HSTS) when ENV=production.
COOKIE_SECURE=
SESSION_DAYS=14
MIN_PASSWORD_LENGTH=10
APP_BASE_URL=http://localhost:8000
# "console" prints emails (reset links) to the server log. "smtp" sends them.
EMAIL_BACKEND=console
EMAIL_FROM=Wardrobe <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
LOGIN_ATTEMPTS_PER_ACCOUNT=5
LOGIN_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_MINUTES=15
RESET_REQUESTS_PER_ACCOUNT=3
RESET_REQUESTS_PER_IP=10
REGISTER_PER_IP=10

# Weather (Phase 5). Open-Meteo needs no key; only rounded coordinates are sent.
# "none" disables every outside weather call.
WEATHER_PROVIDER=open-meteo
WEATHER_CACHE_MINUTES=60
WEATHER_TIMEOUT_SECONDS=5

# Docker dev: set true if file edits are not picked up by the container (macOS/Windows)
WATCH_POLLING=false

# ---------------------------------------------------------------------------------------
# Production / Vercel (see docs/deployment.md). Everything above still applies.
# ---------------------------------------------------------------------------------------
# ENV=production
# SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_BASE_URL=https://your-app.vercel.app
# DATABASE_URL=          # the provider's *pooled* connection string, with ?sslmode=require
# DB_SERVERLESS=true     # fresh connection per request, no prepared statements
# TRUST_PROXY_HEADERS=true

# Photos need storage that survives (a serverless function has no disk):
# STORAGE_BACKEND=supabase          # or s3; "local" is for Docker and development
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=             # secret: never expose it, it bypasses all access rules
# SUPABASE_BUCKET=wardrobe          # create it as a PRIVATE bucket
# S3_ENDPOINT=<account>.r2.cloudflarestorage.com   # s3 backend: any S3-compatible service
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=
# S3_SECURE=true

# CUTOUT_BACKEND=none     # rembg does not fit in a serverless function; photos stay as uploaded
# PROCESS_IN_REQUEST=true # tag each photo in a request, not a background task
# AI_TIMEOUT_SECONDS=40   # keep below the function time limit (vercel.json: 60)
# MAX_UPLOAD_MB=4         # Vercel rejects request bodies over about 4.5 MB
# MAX_BATCH_FILES=6

# Who can register. Unset: open in development, closed in production unless INVITE_CODE is set.
# REGISTRATION_OPEN=false
# INVITE_CODE=choose-something-friends-can-type
# EMAIL_BACKEND=smtp      # with SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, EMAIL_FROM
