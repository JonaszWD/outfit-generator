.PHONY: vercel-requirements install up down migrate downgrade revision test lint format typecheck dev docker docker-rebuild docker-logs seed user demo demo-link demo-account

install:
	uv sync --extra cutout

# The Vercel build installs from requirements.txt (no rembg, no uvicorn). Rerun after changing
# dependencies.
vercel-requirements:
	{ echo "# Generated by 'make vercel-requirements' from uv.lock for the Vercel build. Do not edit."; \
	  echo "# Left out on purpose: rembg (cutouts do not fit in a function), uvicorn and its extras."; \
	  uv export --no-dev --no-hashes --no-emit-project --no-header --no-emit-package uvicorn \
	    --no-emit-package uvloop --no-emit-package httptools --no-emit-package watchfiles \
	    --no-emit-package websockets; } > requirements.txt

up:
	docker compose up -d db

down:
	docker compose down

migrate:
	uv run alembic upgrade head

downgrade:
	uv run alembic downgrade -1

revision:
	uv run alembic revision --autogenerate -m "$(m)"

test:
	uv run pytest

lint:
	uv run ruff check .
	uv run ruff format --check .

format:
	uv run ruff check --fix .
	uv run ruff format .

typecheck:
	uv run mypy

# App + database in Docker with live reload: edit files, refresh the browser. No rebuild needed.
docker:
	docker compose up -d db app

# Only after changing pyproject.toml, uv.lock or the Dockerfile
docker-rebuild:
	docker compose up -d --build app

docker-logs:
	docker compose logs -f app

dev:
	uv run uvicorn app.main:create_app --factory --reload --port 8000

# EMAIL=you@example.com picks the account (default: DEV_USER_EMAIL)
seed:
	uv run python -m scripts.seed_closet $(if $(EMAIL),--email $(EMAIL))

user:
	uv run python -m scripts.create_user $(if $(EMAIL),--email $(EMAIL))

demo:
	uv run python -m scripts.demo_engine

demo-account:
	uv run python -m scripts.demo_account_flow

demo-link:
	uv run python -m scripts.demo_link_analysis
